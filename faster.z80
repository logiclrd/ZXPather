ORG 32500

    LD A,(arg+1)
    SUB 48
    CP 10
    JR C,highnum
    SUB 7
highnum:
    ADD A,A
    ADD A,A
    ADD A,A
    ADD A,A
    LD C,A
    LD A,(arg)
    SUB 48
    CP 10
    JR C, lownum
    SUB 7
lownum:
    ADD A,C
    LD B,0
    LD C,A
    RET

arg:
    DB '1' ; low digit
    DB 'F' ; high digit (sample data is $F1)